# Copy to .env and edit. Used by docker-compose, the website build and the Flutter release build.

# Public website (e.g. openbird.org)
SITE_DOMAIN=openbird.example.org

# Public API (e.g. api.openbird.org)
API_DOMAIN=api.openbird.example.org

# Email for Let's Encrypt certificate notices (used by Caddy)
ACME_EMAIL=you@example.org

# Protects the analytics dashboard data (GET /analytics/*). Set a long random value; the dashboard page asks for it.
# Leave empty only if the dashboard may be public.
ANALYTICS_TOKEN=

# Set to false to stop collecting analytics events entirely
ANALYTICS_ENABLED=true

# Backend worker (cache warm-up, analytics backup, content stats). Deploy does not warm the cache.
# WORKER_JOBS=cache,analytics_backup,content_stats
# CACHE_EVERY=3600
# BACKUP_EVERY=86400
# STATS_EVERY=86400
# ANALYTICS_BACKUP_KEEP=14

# Memory caps (compose `mem_limit`), defaults sized for a 4 GB server: about 2.9 GB in total. On a bigger server raise them.
# API_MEMORY=640m
# WEB_MEMORY=384m
# WORKER_MEMORY=320m
# REDIS_MEMORY=384m
# REDIS_MAXMEMORY=256mb
# MEILI_MEMORY=1024m
# MEILI_INDEXING_MEMORY=384Mb
# API_WORKERS=1
# LOCAL_CACHE_MAX_MB=48
# Vector (meaning-based) search needs about 1.5 GB more for MeiliSearch. It is off by default; set true on a bigger server
# and re-run the indexer. Names, typos and sentences are answered from memory without it.
# VECTOR_SEARCH=false
# MEILI_TIMEOUT=3
# MEILI_POOL_SIZE=2

# Prebuilt Docker images published by CI (GitHub Container Registry). Only change these for a fork or to pin a build.
# IMAGE_PREFIX=ghcr.io/arashrasoulzadeh
# IMAGE_TAG=latest

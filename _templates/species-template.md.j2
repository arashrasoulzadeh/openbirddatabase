---
# === CORE IDENTIFIERS ===
taxon_id: "{{ taxon_id }}"
ebird_code: "{{ ebird_code }}"
gbif_key: {{ gbif_key }}
{% if avibase_id %}avibase_id: "{{ avibase_id }}"
{% endif %}{% if iucn_status %}iucn_status: "{{ iucn_status }}"
{% endif %}taxon_order: {{ taxon_order }}

# === NAMES (English keys, Persian values) ===
names:
  scientific: "{{ names.scientific }}"
  fa: "{{ names.fa }}"
  en: "{{ names.en }}"
{% for lang, name in names.items() if lang not in ['scientific', 'fa', 'en'] %}
  {{ lang }}: "{{ name }}"
{% endfor %}

# === TAXONOMY ===
taxonomy:
  order: "{{ taxonomy.order }}"
  family: "{{ taxonomy.family }}"
  genus: "{{ taxonomy.genus }}"
  species: "{{ taxonomy.species }}"
{% if taxonomy.subspecies %}
  subspecies:
{% for sub in taxonomy.subspecies %}
    - name: "{{ sub.name }}"
      scientific: "{{ sub.scientific }}"
{% if sub.range %}      range: "{{ sub.range }}"{% endif %}
{% endfor %}
{% endif %}

{% if morphology and (morphology.body_mass_g or morphology.body_length_cm or morphology.wingspan_cm or morphology.bill_length_mm or morphology.tarsus_length_mm or morphology.wing_length_mm or morphology.tail_length_mm) %}
# === MORPHOLOGY (BIRDBASE) ===
morphology:
{% if morphology.body_mass_g %}  body_mass_g: {{ morphology.body_mass_g }}{% endif %}
{% if morphology.body_length_cm %}  body_length_cm: {{ morphology.body_length_cm }}{% endif %}
{% if morphology.wingspan_cm %}  wingspan_cm: {{ morphology.wingspan_cm }}{% endif %}
{% if morphology.bill_length_mm %}  bill_length_mm: {{ morphology.bill_length_mm }}{% endif %}
{% if morphology.tarsus_length_mm %}  tarsus_length_mm: {{ morphology.tarsus_length_mm }}{% endif %}
{% if morphology.wing_length_mm %}  wing_length_mm: {{ morphology.wing_length_mm }}{% endif %}
{% if morphology.tail_length_mm %}  tail_length_mm: {{ morphology.tail_length_mm }}{% endif %}
{% endif %}

# === DISTRIBUTION ===
distribution:
  breeding_range: "{{ distribution.breeding_range }}"
  non_breeding_range: "{{ distribution.non_breeding_range }}"
  countries: {{ (distribution.countries | default([])) | tojson }}
  biogeographic_realms: {{ (distribution.biogeographic_realms | default([])) | tojson }}
  endemic: {{ distribution.endemic | lower }}
  island_endemic: {{ distribution.island_endemic | lower }}

# === HABITAT (BIRDBASE + BirdFYI) ===
habitat:
  primary: "{{ habitat.primary }}"
  secondary: {{ (habitat.secondary | default([])) | tojson }}
  habitat_breadth: {{ habitat.habitat_breadth }}
  elevational_min_m: {{ habitat.elevational_min_m }}
  elevational_max_m: {{ habitat.elevational_max_m }}
  habitat_types: {{ (habitat.habitat_types | default([])) | tojson }}
{% if habitat.microhabitat %}  microhabitat: "{{ habitat.microhabitat }}"{% endif %}

# === DIET (BIRDBASE + AVONICHE) ===
diet:
  primary: "{{ diet.primary }}"
  diet_breadth: {{ diet.diet_breadth }}
  categories:
    invertebrates: {{ diet.categories.invertebrates }}
    seeds: {{ diet.categories.seeds }}
    fruit: {{ diet.categories.fruit }}
    nectar: {{ diet.categories.nectar }}
    vertebrates: {{ diet.categories.vertebrates }}
    fish: {{ diet.categories.fish }}
    carrion: {{ diet.categories.carrion }}
    plant_material: {{ diet.categories.plant_material }}
  foraging_niches:
{% for niche, value in diet.foraging_niches.items() %}
    {{ niche }}: {{ value }}
{% endfor %}
diet_sources: {{ (diet.diet_sources | default([])) | tojson }}

# === BEHAVIOR & SOCIAL (BIRDBASE + BirdFYI) ===
behavior:
  sociality: "{{ behavior.sociality }}"
  flock_size_typical: "{{ behavior.flock_size_typical }}"
{% if behavior.flock_size_max %}  flock_size_max: {{ behavior.flock_size_max }}{% endif %}
  territorial: {{ behavior.territorial | lower }}
  migration_status: "{{ behavior.migration_status }}"
  movement_type: "{{ behavior.movement_type }}"
  activity_pattern: "{{ behavior.activity_pattern }}"
  vocalizations:
    song: "{{ behavior.vocalizations.song }}"
    calls: {{ (behavior.vocalizations.calls | default([])) | tojson }}
  xeno_canto_ids: {{ (behavior.xeno_canto_ids | default([])) | tojson }}

# === REPRODUCTION (BIRDBASE) ===
{% if reproduction and (reproduction.clutch_size_mean or reproduction.clutch_size_min or reproduction.clutch_size_max or reproduction.egg_length_mm or reproduction.egg_width_mm or reproduction.incubation_days or reproduction.fledging_days or reproduction.broods_per_year or reproduction.nest_type or reproduction.nest_placement or reproduction.nest_material or reproduction.mating_system or reproduction.parental_care) %}
reproduction:
{% if reproduction.clutch_size_mean %}  clutch_size_mean: {{ reproduction.clutch_size_mean }}{% endif %}
{% if reproduction.clutch_size_min %}  clutch_size_min: {{ reproduction.clutch_size_min }}{% endif %}
{% if reproduction.clutch_size_max %}  clutch_size_max: {{ reproduction.clutch_size_max }}{% endif %}
{% if reproduction.egg_length_mm %}  egg_length_mm: {{ reproduction.egg_length_mm }}{% endif %}
{% if reproduction.egg_width_mm %}  egg_width_mm: {{ reproduction.egg_width_mm }}{% endif %}
{% if reproduction.incubation_days %}  incubation_days: {{ reproduction.incubation_days }}{% endif %}
{% if reproduction.fledging_days %}  fledging_days: {{ reproduction.fledging_days }}{% endif %}
{% if reproduction.broods_per_year %}  broods_per_year: {{ reproduction.broods_per_year }}{% endif %}
{% if reproduction.nest_type %}  nest_type: "{{ reproduction.nest_type }}"{% endif %}
{% if reproduction.nest_placement %}  nest_placement: "{{ reproduction.nest_placement }}"{% endif %}
  nest_material: {{ (reproduction.nest_material | default([])) | tojson }}
{% if reproduction.mating_system %}  mating_system: "{{ reproduction.mating_system }}"{% endif %}
{% if reproduction.parental_care %}  parental_care: "{{ reproduction.parental_care }}"{% endif %}
{% endif %}

{% if demography and (demography.generation_length_years or demography.max_longevity_years or demography.annual_survival_adult or demography.annual_survival_juvenile or demography.population_trend or demography.population_size or demography.density_individuals_per_km2) %}
# === DEMOGRAPHY (BIRDBASE) ===
demography:
{% if demography.generation_length_years %}  generation_length_years: {{ demography.generation_length_years }}{% endif %}
{% if demography.max_longevity_years %}  max_longevity_years: {{ demography.max_longevity_years }}{% endif %}
{% if demography.annual_survival_adult %}  annual_survival_adult: {{ demography.annual_survival_adult }}{% endif %}
{% if demography.annual_survival_juvenile %}  annual_survival_juvenile: {{ demography.annual_survival_juvenile }}{% endif %}
{% if demography.population_trend %}  population_trend: "{{ demography.population_trend }}"{% endif %}
{% if demography.population_size %}  population_size: "{{ demography.population_size }}"{% endif %}
{% if demography.density_individuals_per_km2 %}  density_individuals_per_km2: {{ demography.density_individuals_per_km2 }}{% endif %}
{% endif %}

# === CONSERVATION ===
conservation:
  iucn_status: "{{ conservation.iucn_status if conservation.iucn_status else iucn_status }}"
{% if conservation.iucn_criteria %}  iucn_criteria: "{{ conservation.iucn_criteria }}"{% endif %}
  cites_appendix: "{{ conservation.cites_appendix }}"
  threats: {{ (conservation.threats | default([])) | tojson }}
  conservation_actions: {{ (conservation.conservation_actions | default([])) | tojson }}

# === VETERINARY & CARE (Manual curation) ===
veterinary:
  common_diseases: {{ (veterinary.common_diseases | default([])) | tojson }}
  vaccination_schedule: {{ (veterinary.vaccination_schedule | default([])) | tojson }}
  deworming_frequency_months: {{ veterinary.deworming_frequency_months }}
  health_check_frequency_months: {{ veterinary.health_check_frequency_months }}
  zoonotic_risks: {{ (veterinary.zoonotic_risks | default([])) | tojson }}
  emergency_signs: {{ (veterinary.emergency_signs | default([])) | tojson }}
{% if veterinary.vet_specialist_type %}  vet_specialist_type: "{{ veterinary.vet_specialist_type }}"{% endif %}

# === ENRICHMENT & PLAY (Manual curation) ===
enrichment:
  foraging_toys: {{ (enrichment.foraging_toys | default([])) | tojson }}
{% if enrichment.social_enrichment %}  social_enrichment: "{{ enrichment.social_enrichment }}"{% endif %}
  cognitive_toys: {{ (enrichment.cognitive_toys | default([])) | tojson }}
{% if enrichment.bathing %}  bathing: "{{ enrichment.bathing }}"{% endif %}
  training:
    target_training: {{ enrichment.training.target_training | lower }}
    recall_training: {{ enrichment.training.recall_training | lower }}
{% if enrichment.training.harness_training %}    harness_training: "{{ enrichment.training.harness_training }}"{% endif %}
  play_behaviors: {{ (enrichment.play_behaviors | default([])) | tojson }}
  environmental_enrichment: {{ (enrichment.environmental_enrichment | default([])) | tojson }}

# === SOURCES & METADATA ===
sources: {{ (sources | default([])) | tojson }}
last_updated: "{{ last_updated }}"
data_quality: "{{ data_quality }}"
---

# {{ names.scientific }} ({{ names.fa }})

## Overview
{{ overview }}

## Identification
{{ identification }}

## Habitat & Distribution
{{ habitat_distribution }}

## Diet & Foraging
{{ diet_foraging }}

## Behavior & Ecology
{{ behavior_ecology }}

## Breeding
{{ breeding }}

## Conservation
{{ conservation }}

## Veterinary Care
{{ veterinary_care }}

## Enrichment & Training
{{ enrichment_training }}
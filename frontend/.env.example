# Website environment variables (local development: copy to .env.local).
# In production these come from the repo-root .env via docker-compose (API_DOMAIN / SITE_DOMAIN).

# Public API address, used by the browser and baked into the build
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public address of the website itself (sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: address server-side rendering uses to reach the API (e.g. the docker network name)
# API_INTERNAL_URL=http://api:8000
